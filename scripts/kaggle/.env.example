# Example environment configuration for Kaggle runners
# Copy this file to .env (e.g. cp .env.example .env)
# NEVER commit .env files containing real credentials or secrets to git.

# Required: Target Kaggle Kernel ID in 'owner/slug' format
# Replace with your actual Kaggle username and desired kernel slug.
KAGGLE_KERNEL_ID=your_kaggle_username/cicdohbrw2020-statistical-baseline

# Optional: Kaggle API credentials (alternative to ~/.kaggle/kaggle.json)
# If using ~/.kaggle/kaggle.json (recommended), leave these blank or unset.
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Optional: Custom path to directory containing kaggle.json (default: ~/.kaggle)
# KAGGLE_CONFIG_DIR=~/.kaggle
